OPENAI_API_KEY=sk-your-key-here

# All settings below are optional -- these are the defaults if unset.
# OPENAI_MODEL=gpt-4o
# DATABASE_URL=sqlite+aiosqlite:///./cashflow.db

# Bulk categorization throughput. The ceiling is your OpenAI org's
# tokens-per-minute limit: ~440 tokens per categorization, so a 30,000 TPM
# tier sustains ~68 calls/min, which one worker nearly saturates on its
# own. 2 runs slightly hot on purpose and lets retry backoff pace it; use
# 1 to never see a 429, or raise it well above 2 on a higher tier.
# CATEGORIZATION_CONCURRENCY=2
# OPENAI_MAX_RETRIES=8

# NOTE: these two are NOT safe to change on a live index. Both the
# embedding model and the persist directory determine what is already
# stored in Chroma -- switching either without rebuilding both collections
# gives you a dimension-mismatch error at best, and silently meaningless
# neighbors at worst (a different model at the same dimensionality).
# Rebuild with scripts/generate_synthetic_data.py + build_vendor_index().
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# CHROMA_PERSIST_DIR=./chroma_data
